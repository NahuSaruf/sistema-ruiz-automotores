# Copiá este archivo a ".env" (no lo subas al repositorio) y completá con los
# datos de tu proyecto de Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Opcional, sólo para entornos SIN Supabase configurado arriba (por ejemplo un
# preview local sin ".env" completo): contraseña compartida de emergencia para
# entrar al Panel Admin sin autenticación real. Si la dejás vacía, el acceso de
# administrador queda deshabilitado en ese entorno (no hay una contraseña por
# defecto en el código). No es un reemplazo de Supabase Auth: cualquiera que
# inspeccione el bundle del sitio puede leerla, así que no la reutilices como
# contraseña real en ningún otro lado.
VITE_ADMIN_FALLBACK_PASSWORD=
